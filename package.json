{
  "name": "cmms-cartonificio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "npm run prisma:generate && next build --webpack",
    "start": "node server.js",
    "build:standalone": "npm run prisma:generate && next build --webpack",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node -e \"process.env.PRISMA_CLIENT_ENGINE_TYPE='binary'; require('child_process').execSync('prisma generate', { stdio: 'inherit', shell: true })\"",
    "prisma:migrate": "node -e \"process.env.PRISMA_CLIENT_ENGINE_TYPE='binary'; require('child_process').execSync('prisma db push', { stdio: 'inherit', shell: true })\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "autoprefixer": "^10.4.27",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.2",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "postcss": "^8.5.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
